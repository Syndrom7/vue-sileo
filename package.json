{
  "name": "vue-sileo",
  "version": "0.1.6",
  "description": "An opinionated, physics-based toast notification library for Vue.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Syndrom7/vue-sileo.git"
  },
  "keywords": [
    "vue",
    "vue3",
    "toast",
    "notification",
    "sileo",
    "notifications",
    "alert",
    "message",
    "physics",
    "animation"
  ],
  "author": "Syndrom7",
  "bugs": {
    "url": "https://github.com/Syndrom7/vue-sileo/issues"
  },
  "homepage": "https://vue-sileo.vercel.app",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/src/lib/index.d.ts",
        "default": "./dist/vue-sileo.mjs"
      },
      "require": {
        "types": "./dist/src/lib/index.d.ts",
        "default": "./dist/vue-sileo.cjs"
      }
    },
    "./styles.css": "./dist/vue-sileo.css"
  },
  "main": "./dist/vue-sileo.cjs",
  "module": "./dist/vue-sileo.mjs",
  "types": "./dist/src/lib/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:app": "vite build --config vite.config.app.ts",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "vue": ">=3.3"
  },
  "devDependencies": {
    "@emnapi/core": "^1.11.1",
    "@emnapi/runtime": "^1.11.1",
    "@types/node": "^25.9.3",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/language-core": "^3.3.5",
    "@vue/tsconfig": "^0.9.1",
    "highlight.js": "^11.11.1",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-dts": "^5.0.2",
    "vue": "^3.5.38",
    "vue-tsc": "^3.3.5"
  },
  "dependencies": {
    "motion-v": "^2.3.0"
  }
}
