{
  "name": "vue-sileo",
  "version": "0.1.0",
  "description": "An opinionated, physics-based toast notification library for Vue.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Syndrom7/vue-sileo.git"
  },
  "keywords": [
    "vue",
    "vue3",
    "toast",
    "notification",
    "sileo",
    "notifications",
    "alert",
    "message",
    "physics",
    "animation"
  ],
  "author": "Syndrom7",
  "bugs": {
    "url": "https://github.com/Syndrom7/vue-sileo/issues"
  },
  "homepage": "https://github.com/Syndrom7/vue-sileo#readme",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/vue-sileo.d.ts",
        "default": "./dist/vue-sileo.mjs"
      },
      "require": {
        "types": "./dist/vue-sileo.d.ts",
        "default": "./dist/vue-sileo.cjs"
      }
    },
    "./styles.css": "./dist/vue-sileo.css"
  },
  "main": "./dist/vue-sileo.cjs",
  "module": "./dist/vue-sileo.mjs",
  "types": "./dist/vue-sileo.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:app": "vite build --config vite.config.app.ts",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "vue": ">=3.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vue/tsconfig": "^0.8.1",
    "typescript": "~5.9.3",
    "vite": "^8.0.0-beta.13",
    "vite-plugin-dts": "^4.5.4",
    "vue": "^3.5.25",
    "vue-tsc": "^3.1.5"
  },
  "overrides": {
    "vite": "^8.0.0-beta.13"
  }
}